# Byte-compiled / optimized / DLL files
*__pycache__/
*.py[cod]

# Virtual environments
.venv/
venv/

# Packaging
dist/
build/
*.egg-info/

# Editor / OS
.DS_Store
.idea/

# Output directories
outputs/

# Cache directories
src/radarlib/cacheVVG_Map/
cache/

# Generated documentation (keep source .md files)
docs/es/*.html
docs/es/*.pdf

.claude/

# Secrets (real values live only on each machine; see .env.example)
.env

# Local artifacts that must never be committed (prod logs, state DBs, dumps).
# Anchored to the repo root on purpose: src/radarlib/io/bufr/... tracks .zip
# sources that a global *.zip rule would hide in the future.
/*.db
/*.log.txt
/*.zip
/*.npz
# Runtime evidence pulled from stage/operativo (see gl-platform) and personal scratch
ops-data/
local/
